<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#f7f6f0">
    <title>{% block title %}Les Amis de l'École Mitsinjo{% endblock %}</title>
    <meta name="description" content="L'association Les Amis de l'École Mitsinjo agit pour l'éducation et le bien-être des enfants à Madagascar.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/bootstrap.min.css') }}">
    <link rel="stylesheet" href="{{ asset('css/app.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    {% block stylesheets %}{% endblock %}
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg site-nav" aria-label="Navigation principale">
            <div class="container nav-container">
                <a class="navbar-brand brand" href="{{ path('home') }}">
                    <img src="{{ asset('mitsinjo/logo-mitsimbina.jpg') }}" alt="" class="brand-logo">
                    <span>Les Amis de <strong>Mitsinjo</strong></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#main-navigation" aria-controls="main-navigation" aria-expanded="false" aria-label="Ouvrir le menu">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="main-navigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center">
                        <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'home' ? 'active' : '' }}" href="{{ path('home') }}">Accueil</a></li>
                        <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'about' ? 'active' : '' }}" href="{{ path('about') }}">À propos</a></li>
                        <li class="nav-item"><a class="nav-link {{ app.request.attributes.get('_route') == 'achievements' ? 'active' : '' }}" href="{{ path('achievements') }}">Réalisations</a></li>
                        <li class="nav-item nav-contact"><a class="nav-link {{ app.request.attributes.get('_route') == 'contact' ? 'active' : '' }}" href="{{ path('contact') }}">Nous contacter <span aria-hidden="true">↗</span></a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    {% for message in app.flashes('success') %}
        <div class="container flash-wrap"><div class="alert alert-success" role="status">{{ message }}</div></div>
    {% endfor %}

    <main>{% block body %}{% endblock %}</main>

    <footer class="site-footer">
        <div class="container footer-main">
            <a class="footer-brand" href="{{ path('home') }}">Les Amis de<br><strong>l'École Mitsinjo</strong></a>
            <p class="footer-address">Mitsimbina<br>Antananarivo 101, Madagascar</p>
            <div class="footer-contact">
                <a href="mailto:association.ecole.mitsimbina@gmail.com">association.ecole.mitsimbina@gmail.com</a>
                <a href="tel:+261344640412">+261 34 46 404 12</a>
            </div>
            <a class="footer-social" href="https://www.facebook.com/profile.php?id=100070002064726" aria-label="Page Facebook des Amis de l'École Mitsinjo" rel="noopener noreferrer" target="_blank"><i class="fa-brands fa-facebook-f" aria-hidden="true"></i></a>
        </div>
        <div class="container footer-bottom"><span>© {{ 'now'|date('Y') }} Les Amis de l'École Mitsinjo</span><span>Ensemble, ouvrons le champ des possibles.</span></div>
    </footer>

    <script src="{{ asset('js/bootstrap.bundle.min.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>
