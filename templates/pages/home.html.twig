{% extends 'base.html.twig' %}

{% block title %}Accueil | Les Amis de l'École Mitsinjo{% endblock %}

{% block body %}
<section class="home-hero">
    <div id="home-gallery" class="carousel slide hero-carousel" data-bs-ride="carousel" data-bs-interval="6500">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#home-gallery" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Photo 1"></button>
            <button type="button" data-bs-target="#home-gallery" data-bs-slide-to="1" aria-label="Photo 2"></button>
            <button type="button" data-bs-target="#home-gallery" data-bs-slide-to="2" aria-label="Photo 3"></button>
        </div>
        <div class="carousel-inner">
            <div class="carousel-item active"><img src="{{ asset('mitsinjo/img1.jpg') }}" alt="La vie des enfants à l'école Mitsinjo"><div class="hero-shade"></div></div>
            <div class="carousel-item"><img src="{{ asset('mitsinjo/img2.jpg') }}" alt="Les élèves et leur communauté"><div class="hero-shade"></div></div>
            <div class="carousel-item"><img src="{{ asset('mitsinjo/img3.jpg') }}" alt="Un moment partagé à l'école"><div class="hero-shade"></div></div>
        </div>
        <div class="container hero-content">
            <p class="eyebrow hero-eyebrow"><span></span> Antananarivo · Madagascar</p>
            <h1>Grandir ensemble,<br><em>apprendre autrement.</em></h1>
            <p class="hero-lead">Aux côtés de l'École Mitsinjo, nous faisons de l'éducation et du bien-être des enfants une aventure collective.</p>
            <a class="button button-light" href="{{ path('about') }}">Découvrir l'association <span aria-hidden="true">↗</span></a>
        </div>
        <div class="hero-caption"><span>01 / 03</span><span>Une communauté engagée pour chaque enfant</span></div>
    </div>
</section>

<section class="intro-section section-pad">
    <div class="container intro-grid">
        <div>
            <p class="eyebrow"><span></span> Notre engagement</p>
            <h2>Une école forte,<br>une communauté qui avance.</h2>
        </div>
        <div class="intro-copy">
            <p>Les Amis de l'École Mitsinjo soutiennent les élèves du primaire à Mitsimbina. Ensemble, nous contribuons à améliorer les conditions d'apprentissage, à encourager la curiosité et à donner à chaque enfant l'espace nécessaire pour révéler son potentiel.</p>
            <a class="text-link" href="{{ path('about') }}">En savoir plus sur nous <span aria-hidden="true">→</span></a>
        </div>
    </div>
</section>

<section class="home-photo-band">
    <img src="{{ asset('mitsinjo/fete.jpg') }}" alt="Une fête organisée avec la communauté de l'école">
    <div class="photo-band-copy"><p class="eyebrow">Faire équipe</p><h2>Chaque geste<br>compte pour demain.</h2><a class="button button-light" href="{{ path('contact') }}">Nous rejoindre <span aria-hidden="true">↗</span></a></div>
</section>
{% endblock %}
